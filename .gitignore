# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Build artifacts
build/
dist/
*.spec
*.egg-info/

# C# build artifacts
bin/
obj/
*.pdb
*.cache
*.AssemblyInfo.cs
*.AssemblyAttributes.cs

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
run_log.txt

# Local user configs (runtime state)
**/main_config.json
**/*_config.json

# API keys — never commit
api_keys.json
**/api_keys.json

# Temp folders
**/temp/
**/upload_temp/
**/dropped_images/archive/

# Auto-generated app state
**/error_log.txt
**/settings.json

# Sample / test media files
*.mp4
*.avi
*.mov
*.mkv

# Compiled executables and archives (too large for git)
*.exe
*.zip
*.msi
*.dmg
*.pkg
*.tar.gz
*.7z
*.rar

# NOTE: *.dll and *.pyd are NOT ignored — some apps bundle required
# binary dependencies. Include them if under GitHub's 50 MB file limit.

# Nested repos with their own git history
PromptArchiver/
