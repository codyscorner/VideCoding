<Window x:Class="ScreenSnap.UI.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenSnap.UI.Controls"
        Title="ScreenSnap Editor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="Arrow (A)"     Command="{Binding ActivateToolCommand}" CommandParameter="arrow"/>
            <Button Content="Rect (R)"      Command="{Binding ActivateToolCommand}" CommandParameter="rect"/>
            <Button Content="Ellipse (E)"   Command="{Binding ActivateToolCommand}" CommandParameter="ellipse"/>
            <Button Content="Freehand (F)"  Command="{Binding ActivateToolCommand}" CommandParameter="freehand"/>
            <Button Content="Highlight (H)" Command="{Binding ActivateToolCommand}" CommandParameter="highlight"/>
            <Button Content="Text (T)"      Command="{Binding ActivateToolCommand}" CommandParameter="text"/>
            <Button Content="Bubble (B)"    Command="{Binding ActivateToolCommand}" CommandParameter="bubble"/>
            <Separator/>
            <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
            <Separator/>
            <Button Content="Copy" Command="{Binding CopyCommand}"/>
            <Button Content="Save" Command="{Binding SaveCommand}"/>
        </ToolBar>

        <!-- Canvas -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <controls:AnnotationCanvas x:Name="Canvas"/>
        </ScrollViewer>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem Content="{Binding ActiveTool, StringFormat='Tool: {0}'}"/>
            <Separator/>
            <StatusBarItem Content="{Binding StatusText}"/>
        </StatusBar>
    </Grid>
</Window>
