<Window x:Class="ScreenSnap.UI.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Text" Height="120" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="InputBox" Grid.Row="0" VerticalAlignment="Center"
                 FontSize="14" Padding="4"
                 KeyDown="InputBox_KeyDown"
                 TextChanged="InputBox_TextChanged"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Width="70" IsDefault="True"
                    Click="OkButton_Click" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="70" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
