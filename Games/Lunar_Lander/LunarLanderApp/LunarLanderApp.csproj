<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LunarLander</AssemblyName>
    <RootNamespace>LunarLanderApp</RootNamespace>
    <ApplicationIcon>LunarLander.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <!-- Embed the HTML game as a manifest resource -->
  <ItemGroup>
    <EmbeddedResource Include="..\LunarLander.html" LogicalName="LunarLander.html" />
  </ItemGroup>

</Project>
